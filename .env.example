# Copy to .env and `source .env`. The tool reads these from the environment, it does
# not auto-load .env. Every line is an optional override, so uncomment only what you
# actually set. A source without its key falls back to its keyless mode and says so.

# Model backend, the triage judge. Triage is model-driven, it reads the enriched surface
# and the scenario's knowledge and mints the findings. By default it runs on the
# operator's Claude Code subscription through a headless `claude -p`, so it needs no
# provider key. Set OPFOR_API_KEY to call the Anthropic API instead.
# OPFOR_EXECUTOR=auto              # auto calls the API when a key is reachable, else runs
#                                  # on the Claude Code subscription. api forces the API and
#                                  # requires a key. subscription forces `claude -p`.
# OPFOR_PROVIDER=anthropic         # the vendor for the api path, anthropic or openai
# OPFOR_MODEL=claude-opus-4-8      # the model name, advisory on the subscription path
# OPFOR_API_KEY=your_key_here      # an API key, switches auto to the API path
# OPFOR_API_BASE=https://...       # an alternate API base URL, for a proxy or gateway
# OPFOR_WIRE_API=chat              # openai wire, chat or responses, gpt-5 reasoning models
#                                  # need responses. ignored by the anthropic provider
# OPFOR_CLAUDE_BIN=claude          # the Claude Code binary for the subscription path
# OPFOR_RETRIES=2                  # api retries on a transient failure
# OPFOR_TIMEOUT=240                # per call deadline in seconds

# Triage judging mode. standard, the default, is one model per surface chunk. adversarial
# adds a skeptic that tries to refute each finding and a judge that breaks the tie, so a
# false positive must survive a second opinion, at the cost of more model calls. The roles
# reuse the base backend, a per-role model gives an uncorrelated second opinion.
# OPFOR_TRIAGE_MODE=adversarial
# OPFOR_CHALLENGER_MODEL=claude-opus-4-8   # the skeptic model, defaults to OPFOR_MODEL
# OPFOR_JUDGE_MODEL=claude-opus-4-8        # the tie-break model, defaults to OPFOR_MODEL

# Seed files, the attacksurface run. `opfor run attacksurface` seeds from roots, hosts, or
# both. A flag wins, and when the flag is absent the path comes from here, so a fixed
# target lives in .env and a one-off is a flag. Roots fold to their registrable root and
# are expanded, hosts enter as leaves and are enriched, the way to supply subdomains a
# wildcard certificate hides from passive discovery, such as a DNS export.
# OPFOR_TARGET=acme                       # the campaign name, defaults to the first root
# OPFOR_ROOTS_FILE=/path/to/roots.txt     # one root domain per line, --roots overrides
# OPFOR_HOSTS_FILE=/path/to/hosts.txt     # one known host per line, --hosts overrides

# GitHub, the attacksurface scenario. Unauthenticated search and repo listing work at a
# low rate, a token only raises the limit for a wide org.
# OPFOR_GITHUB_TOKEN=your_token_here   # a fine-grained token with public read is enough
# GITHUB_TOKEN=your_token_here         # read as a fallback when OPFOR_GITHUB_TOKEN is unset

# VirusTotal, the attacksurface scenario. The reliable free passive subdomain source. A
# key gives a real per-account quota, so it works from a server where the keyless passive
# sources are throttled by shared address. A free account provides one. Optional.
# OPFOR_VIRUSTOTAL_KEY=your_key_here

# Certspotter, the attacksurface scenario. Certificate-transparency reads work without a
# key, but the free tier throttles the paging that walks a large log, so this token makes a
# full subdomain walk reliable. A free account provides one. Optional.
# OPFOR_CERTSPOTTER_KEY=your_key_here

# Reverse-WHOIS, the attacksurface scenario. The reliable core for finding a target's
# other root domains, ownership by registration. It has no keyless mode, a provider bills
# for the bulk index, so without this key the registrant pivot is left out of the run.
# OPFOR_REVERSE_WHOIS_KEY=your_key_here
